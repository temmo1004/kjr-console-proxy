{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode gzip
	reverse_proxy https://basidemac-mini.tail571da9.ts.net {
		header_up Host basidemac-mini.tail571da9.ts.net
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-Client-IP {http.request.remote.host}
		transport http {
			tls
			tls_server_name basidemac-mini.tail571da9.ts.net
		}
		lb_try_duration 10s
		lb_try_interval 500ms
		fail_duration 3s
	}
}
